<UserControl x:Class="OnedriveBackuper.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OnedriveBackuper.App.Views"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Margin="0,18,0,14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,0,12,22">
                <Image Source="/Assets/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="OnedriveBackuper" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <!-- While a backup runs, a small progress card stays visible whatever page is open. -->
            <Border DockPanel.Dock="Bottom" Margin="12,0" Padding="14,12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding Run.IsRunning, Converter={StaticResource VisibleWhenTrue}}">
                <StackPanel>
                    <TextBlock Text="{Binding Run.Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ProgressBar Height="4" Margin="0,8,0,6" Maximum="100"
                                 Value="{Binding Run.OverallPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding Run.OverallIndeterminate, Mode=OneWay}" />
                    <TextBlock Text="{Binding Run.OverallPercentText}" Style="{StaticResource Secondary}" />
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                     ItemContainerStyle="{StaticResource NavItem}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" />
                            <TextBlock Text="{Binding Title}" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Pages -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <views:HomeView Visibility="{Binding IsHome, Converter={StaticResource VisibleWhenTrue}}" />
                <Border Visibility="{Binding IsBackups, Converter={StaticResource VisibleWhenTrue}}">
                    <views:BackupsView DataContext="{Binding Backups}" />
                </Border>
                <Border Visibility="{Binding IsSchedule, Converter={StaticResource VisibleWhenTrue}}">
                    <views:ScheduleView DataContext="{Binding Schedule}" />
                </Border>
                <Border Visibility="{Binding IsSettings, Converter={StaticResource VisibleWhenTrue}}">
                    <views:SettingsView DataContext="{Binding SettingsPage}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
