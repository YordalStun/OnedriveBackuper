<UserControl x:Class="OnedriveBackuper.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,28" MaxWidth="980">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Changes are saved straight away." Style="{StaticResource PageSubtitle}" />

            <!-- Folders -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Folders" Style="{StaticResource CardTitle}" Margin="0" />
                    <TextBlock Text="Your OneDrive folder" Style="{StaticResource Label}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Find it" Padding="14,6" Margin="8,0,0,0" Command="{Binding DetectSourceCommand}"
                                ToolTip="Use the folder OneDrive itself reports." />
                        <Button DockPanel.Dock="Right" Content="Browse..." Padding="14,6" Margin="8,0,0,0" Command="{Binding BrowseSourceCommand}" />
                        <TextBox Text="{Binding SourceFolder}" />
                    </DockPanel>
                    <TextBlock Text="Save backups in" Style="{StaticResource Label}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse..." Padding="14,6" Margin="8,0,0,0" Command="{Binding BrowseBackupCommand}" />
                        <TextBox Text="{Binding BackupFolder}" />
                    </DockPanel>
                    <TextBlock Text="{Binding BackupFolderWarning}" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                               Visibility="{Binding BackupFolderWarning, Converter={StaticResource VisibleWhenText}}" />
                </StackPanel>
            </Border>

            <!-- Exclusions -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Leave out" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,10">
                        Files and folders to skip, one per line. * matches anything. For example:  *.tmp  ·  Videos  ·  Pictures/Camera Roll
                    </TextBlock>
                    <TextBox Text="{Binding ExcludeText}" AcceptsReturn="True" Height="96" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                </StackPanel>
            </Border>

            <!-- Space -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Free space" Style="{StaticResource CardTitle}" Margin="0" />
                    <TextBlock Text="Always keep at least this much free on the OneDrive drive" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding ReserveGb}" Width="80" />
                        <TextBlock Text="GB" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="A file that would leave less than this is skipped (and reported) instead of filling up the drive."
                               Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                    <TextBlock Text="How to free up space after copying a file" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding FreeUpMethods}" SelectedIndex="{Binding FreeUpMethodIndex}" MaxWidth="560" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Check this PC -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Check this PC" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Secondary}">
                        See how much of your OneDrive is online-only and whether there is enough free space (downloads nothing),
                        or test the whole download, copy and free-up cycle with a single online-only file.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Padding="16,7" Margin="0,0,8,0" Command="{Binding CheckOneDriveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Check my OneDrive" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Padding="16,7" Command="{Binding TestFileCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Test with one file..." VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsWorking, Converter={StaticResource VisibleWhenTrue}}">
                        <TextBlock Text="{Binding ToolTitle}" Style="{StaticResource Secondary}" />
                        <ProgressBar Height="4" Margin="0,6,0,0" IsIndeterminate="True" />
                    </StackPanel>
                    <TextBox Text="{Binding ToolOutput, Mode=OneWay}" IsReadOnly="True" Margin="0,12,0,0" TextWrapping="Wrap"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding ToolOutput, Converter={StaticResource VisibleWhenText}}" />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open" Padding="14,6" VerticalAlignment="Center" Command="{Binding OpenDataFolderCommand}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,2">
                            <Run Text="OnedriveBackuper" />
                            <Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Secondary}">
                            <Run Text="Settings are kept in" />
                            <Run Text="{Binding DataFolder, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
