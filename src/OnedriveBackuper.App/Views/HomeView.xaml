<UserControl x:Class="OnedriveBackuper.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OnedriveBackuper.App.ViewModels"
             xmlns:views="clr-namespace:OnedriveBackuper.App.Views">
    <UserControl.Resources>
        <!-- The five counters, shared by the progress and result screens. DataContext: RunViewModel. -->
        <DataTemplate x:Key="Counters">
            <UniformGrid Columns="5" Margin="0,0,0,12">
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding Copied}" Style="{StaticResource StatNumber}" />
                        <TextBlock Text="Copied" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding Unchanged}" Style="{StaticResource StatNumber}" />
                        <TextBlock Text="Unchanged" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding Downloaded}" Style="{StaticResource StatNumber}" />
                        <TextBlock Text="Downloaded" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding FreedUp}" Style="{StaticResource StatNumber}" />
                        <TextBlock Text="Freed up again" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{Binding ProblemCount}" Style="{StaticResource StatNumber}" />
                        <TextBlock Text="Problems" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </DataTemplate>

        <!-- The activity log card. DataContext: RunViewModel. -->
        <DataTemplate x:Key="Activity">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox DockPanel.Dock="Right" Content="Only problems" IsChecked="{Binding OnlyProblems}" />
                        <TextBlock Text="Activity" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding LogView}" Height="210" views:AutoScroll.ToEnd="True"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="0,1" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="Message" Grid.Column="1" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                        <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                        <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="INFO">
                                        <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,28,36,28" MaxWidth="980" HorizontalAlignment="Stretch">

            <!-- ============ Idle: status, folders, how it works ============ -->
            <StackPanel Visibility="{Binding ShowIdle, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Text="Home" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Backs up your OneDrive one file at a time, so this PC never needs room for all of it."
                           Style="{StaticResource PageSubtitle}" />

                <!-- First run: no backup folder yet -->
                <Border Style="{StaticResource Card}" Visibility="{Binding NeedsBackupFolder, Converter={StaticResource VisibleWhenTrue}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Choose folder..." Padding="18,7" VerticalAlignment="Center"
                                Style="{DynamicResource AccentButtonStyle}" Command="{Binding ChooseBackupFolderCommand}" />
                        <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="28" Margin="0,0,18,0"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Choose where to save your backups" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="A USB disk, a second drive or a network folder. Not inside OneDrive itself."
                                       Style="{StaticResource Secondary}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Status -->
                <Border Style="{StaticResource ResultBanner}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ResultIcon}" VerticalAlignment="Top" Margin="0,2,18,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding StatusHeadline}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding NextRunText}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13">
                                    <Hyperlink Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Schedule}">Change</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{DynamicResource AccentButtonStyle}" Padding="20,8" Margin="0,0,8,0"
                                        Command="{Binding BackUpNowCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Back up now" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Full backup" Padding="16,8" Command="{Binding FullBackupNowCommand}"
                                        ToolTip="Copy every file again, not just new and changed ones." />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Folders -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE753;" Style="{StaticResource Icon}" FontSize="22" Margin="0,2,14,0"
                                       VerticalAlignment="Top" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <StackPanel>
                                <TextBlock Text="Backing up" Style="{StaticResource Secondary}" />
                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding SourceFreeText}" Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="22" Margin="0,2,14,0"
                                       VerticalAlignment="Top" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <StackPanel>
                                <TextBlock Text="Saving backups in" Style="{StaticResource Secondary}" />
                                <TextBlock Text="{Binding BackupText}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding BackupFreeText}" Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- How it works -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="How it works" Style="{StaticResource CardTitle}" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Left" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="1. Download" FontWeight="SemiBold" Margin="0,8,0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="A file that is only in the cloud is downloaded, one at a time." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Left" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="2. Copy and check" FontWeight="SemiBold" Margin="0,8,0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="It is copied to your backup folder and checked with a checksum." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="&#xE753;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Left" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="3. Free up space" FontWeight="SemiBold" Margin="0,8,0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="The space is freed again, so it is online-only just like before." Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ Running: live progress ============ -->
            <StackPanel DataContext="{Binding Run}" Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhenTrue}}">
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Padding="16,7" VerticalAlignment="Top" Command="{Binding StopCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Stop" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding PhaseText}" Style="{StaticResource PageSubtitle}" Margin="0" />
                    </StackPanel>
                </DockPanel>

                <!-- Overall -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding OverallPercentText}" Style="{StaticResource BigNumber}" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding OverallDetail}" Style="{StaticResource Secondary}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </StackPanel>
                        <ProgressBar Height="8" Margin="0,10,0,8" Maximum="100"
                                     Value="{Binding OverallPercent, Mode=OneWay}" IsIndeterminate="{Binding OverallIndeterminate, Mode=OneWay}" />
                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Secondary}" />
                        <TextBlock Text="{Binding CheckedText}" Style="{StaticResource Secondary}" Margin="0,14,0,0" />
                        <ProgressBar Height="4" Margin="0,6,0,0" Maximum="100" Value="{Binding CheckedPercent, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Current file -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasCurrentFile, Converter={StaticResource VisibleWhenTrue}}">
                    <StackPanel>
                        <TextBlock Text="Working on" Style="{StaticResource Secondary}" Margin="0,0,0,8" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="26" Margin="0,0,14,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentSize}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding CurrentFolder}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Border Style="{StaticResource StepPill}" DataContext="{Binding DownloadStep}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Border Style="{StaticResource StepPill}" DataContext="{Binding CopyStep}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Border Style="{StaticResource StepPill}" DataContext="{Binding FreeUpStep}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding CurrentAction}" Style="{StaticResource Secondary}" Margin="0,14,0,0" />
                        <ProgressBar Height="4" Margin="0,6,0,0" Maximum="100"
                                     Value="{Binding CurrentPercent, Mode=OneWay}" IsIndeterminate="{Binding CurrentIndeterminate, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Counters}" Focusable="False" />

                <!-- Free space: the whole point is that it stays about the same -->
                <Border Style="{StaticResource Card}" Visibility="{Binding DriveFreeText, Converter={StaticResource VisibleWhenText}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="22" Margin="0,0,14,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding DriveFreeText}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="Only one file is downloaded at a time and freed up right after, so this stays about the same during the whole backup."
                                       Style="{StaticResource Secondary}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ContentControl x:Name="RunningActivity" Content="{Binding}" ContentTemplate="{StaticResource Activity}" Focusable="False" />
            </StackPanel>

            <!-- ============ Finished: result ============ -->
            <StackPanel DataContext="{Binding Run}" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Text="Home" Style="{StaticResource PageTitle}" />
                <TextBlock Text="The backup has finished." Style="{StaticResource PageSubtitle}" />

                <Border Style="{StaticResource ResultBanner}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ResultIcon}" VerticalAlignment="Top" Margin="0,2,18,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ResultHeadline}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Done" Style="{DynamicResource AccentButtonStyle}" Padding="22,7" Margin="0,0,8,0" Command="{Binding DismissCommand}" />
                                <Button Content="Open log" Padding="16,7" Command="{Binding OpenLogCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Counters}" Focusable="False" />

                <Border Style="{StaticResource Card}" Visibility="{Binding HasProblems, Converter={StaticResource VisibleWhenTrue}}">
                    <StackPanel>
                        <TextBlock Text="Problems" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="These keep their previous backup (if any) and are tried again next time."
                                   Style="{StaticResource Secondary}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Problems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Error}" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Activity}" Focusable="False" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
